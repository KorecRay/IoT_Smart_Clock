{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cloudflare",
    "main": "src/worker.js",
    "compatibility_date": "2026-10-01",
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "ratelimits": [
        {
            "name": "smartclockapiservice_ratelimiter",
            "namespace_id": "912",
            "simple": {
                "limit": 1,
                "period": 60
            }
        }
    ],
}